# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Virtual environments ---
.venv/
.venv-win/
venv/
env/
ENV/

# --- IDEs / editors ---
.idea/
.vscode/
*.iml

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
**/logs/*.log

# --- Large / regenerable data (lean policy: kept locally, not versioned) ---
# Raw Fedstat dumps and processed long tables are regenerable via fedstat_lab_downloader.py
**/data/fedstat_targets/raw/
**/data/fedstat_targets/processed/
**/data/geo/cache/
# 59 MB region boundaries — too large for git
**/data/geo/custom_geoboundaries_rus_adm1.geojson
# raw OSM dumps (regenerable via analysis/fetch_rail_stations.py)
**/data/geo/osm_*_raw.json
# raw climate archives (regenerable via analysis/fetch_climate_ghcn.py)
**/data/climate/raw/
# raw EMISS excel chunks (regenerable via analysis/fetch_emiss_generic.py)
**/data/emiss_downloads/raw/
# raw census xlsx (one-time download from rosstat mediabank)
**/data/census/raw/
